# Database (SQL Server)
DB_SERVER=your-sql-server-host
DB_NAME=your-database-name
DB_AUTH=sql
DB_USER=your-application-user
DB_PASSWORD="your-password-here"
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERT=yes
# Set false only for explicitly configured localhost HTTP development.
# Local HTTP development only. Set APP_ENV=production (or explicitly set
# AUTH_COOKIE_SECURE=true) for HTTPS deployments.
APP_ENV=development
AUTH_COOKIE_SECURE=false

# Reversible demo gate (server-side; leave disabled for the general demo).
# When enabled, only this authenticated account may use the application.
LEADERSHIP_ONLY_DEMO=true
LEADERSHIP_DEMO_ACCOUNT=your-demo-account

# Groq
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
